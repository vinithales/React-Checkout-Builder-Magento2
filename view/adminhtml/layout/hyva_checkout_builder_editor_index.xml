    <head>
        <css src="FriendsOfHyva_CheckoutExample::css/editor.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <block name="hyva.checkout.builder.editor"
                   template="FriendsOfHyva_CheckoutExample::editor.phtml">
                <arguments>
                    <argument name="editor_config" xsi:type="object">FriendsOfHyva\CheckoutExample\ViewModel\EditorConfig</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
