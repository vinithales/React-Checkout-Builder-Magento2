<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="hyva_checkout_builder_layout" resource="default" engine="innodb"
           comment="Hyva Checkout Builder Layout">
        <column xsi:type="int" name="layout_id" unsigned="true" nullable="false" identity="true"
                comment="Layout ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0"
                comment="Store ID"/>
        <column xsi:type="mediumtext" name="draft_json" nullable="true" comment="Draft Layout JSON"/>
        <column xsi:type="mediumtext" name="published_json" nullable="true" comment="Published Layout JSON"/>
        <column xsi:type="int" name="version" unsigned="true" nullable="false" default="1"
                comment="Optimistic Lock Version"/>
        <column xsi:type="int" name="draft_updated_by" unsigned="true" nullable="true"
                comment="Draft Admin User ID"/>
        <column xsi:type="int" name="published_by" unsigned="true" nullable="true"
                comment="Publishing Admin User ID"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Updated At"/>
        <column xsi:type="timestamp" name="published_at" nullable="true" on_update="false"
                comment="Published At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="layout_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="HYVA_CHECKOUT_BUILDER_LAYOUT_STORE_ID">
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="HYVA_CHECKOUT_BUILDER_LAYOUT_STORE_ID_STORE_STORE_ID"
                    table="hyva_checkout_builder_layout" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
</schema>
